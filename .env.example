# Copy to .env and fill in. Never commit .env.
BOSON_API_KEY=
TAVILY_API_KEY=
INSFORGE_URL=
INSFORGE_API_KEY=
OPENROUTER_API_KEY=
PATRICK_VOICE=marcus
LLM_MODEL=google/gemini-2.5-flash
# The gateway accepts browser calls only from these origins (your Sites domain and localhost).
ALLOWED_ORIGINS=http://localhost:5173

# Safe sending. Anything other than the exact word false means safe mode is on.
SAFE_MODE=true
DEMO_AUTHORITY_INBOX=
DEMO_CALLER_INBOX=
