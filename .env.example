# Copy to .env and fill in. Never commit .env.
BOSON_API_KEY=
TAVILY_API_KEY=
INSFORGE_URL=
INSFORGE_API_KEY=
OPENROUTER_API_KEY=
# Text model. Set OPENAI_API_KEY to use OpenAI instead of the InsForge Model
# Gateway, and set LLM_MODEL to a model that accepts temperature 0 (the GPT-5.5
# and newer reasoning models reject it). LLM_BASE_URL overrides either default.
OPENAI_API_KEY=
LLM_BASE_URL=
PATRICK_VOICE=marcus
LLM_MODEL=
# The gateway accepts browser calls only from these origins (your Sites domain and localhost).
ALLOWED_ORIGINS=http://localhost:5173

# Safe sending. Anything other than the exact word false means safe mode is on.
SAFE_MODE=true
DEMO_AUTHORITY_INBOX=
DEMO_CALLER_INBOX=
